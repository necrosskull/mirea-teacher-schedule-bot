# Schedule backend of the official МИРЭА app (Supabase).
# No credentials are stored in the repository: fill these values in your local
# .env, which is ignored by git. Ask the project maintainers for the URL and
# the publishable (client) key.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="sb_publishable_<your-key>"
SCHEDULE_ORGANIZATION_ID="mirea"
